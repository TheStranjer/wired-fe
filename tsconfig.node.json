{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "tooling",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "stylelint.config.js"
  ]
}
